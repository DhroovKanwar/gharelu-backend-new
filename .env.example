APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Origins allowed to call the API from a browser (CORS). Each takes one origin or a comma-separated list, e.g.
# FRONTEND_URL=https://gharelubake.in,https://www.gharelubake.in  ADMIN_URL=https://admin.gharelubake.in. No wildcard.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Shop mailbox(es) that get a new-order email, comma-separated. Leave empty to skip.
ORDER_NOTIFY_EMAILS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shiprocket (delivery fee by pincode). Use the API user created in Shiprocket settings.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=

# Flat-fee own delivery for nearby pincodes (comma-separated, or prefix with *, e.g. 1406*)
LOCAL_DELIVERY_PINCODES=
LOCAL_DELIVERY_FEE=49

# ── Production (Forge) ─────────────────────────────────────────────────────
# Set these on the server instead of the local values above:
#   APP_ENV=production        APP_DEBUG=false        APP_URL=https://api.gharelubake.in
#   DB_CONNECTION=mysql       DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD from Forge
#   FRONTEND_URL=https://gharelubake.in      ADMIN_URL=https://admin.gharelubake.in
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET = live keys, RAZORPAY_WEBHOOK_SECRET = its own secret
#   SHIPROCKET_*  = API user (add the server IP to Shiprocket > Settings > API > Allowed IPs)
#   MAIL_*        = real SMTP
# Never run `php artisan db:seed` in production. Create the first admin with:
#   php artisan admin:create

# Order confirmation SMS (customer + shop). SMS_DRIVER: log (default), fast2sms_quick (no DLT), fast2sms, msg91 or none.
# Indian SMS needs DLT-approved templates; put their MSG91 Flow template ids here.
SMS_DRIVER=log
SMS_ADMIN_PHONES=
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_CUSTOMER_MESSAGE_ID=
FAST2SMS_ADMIN_MESSAGE_ID=
MSG91_AUTH_KEY=
MSG91_CUSTOMER_TEMPLATE_ID=
MSG91_ADMIN_TEMPLATE_ID=
